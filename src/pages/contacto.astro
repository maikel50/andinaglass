---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="bg-neutral-50 py-10 text-center">
    <h1 class="text-3xl font-bold text-neutral-900">Contactos</h1>
    <p class="text-neutral-600 mt-2 max-w-xl mx-auto">
      Escribenos para cotizar tu proyecto o resolver cualquier duda que tengas.
      Nuestro equipo estará encantado de ayudarte.
    </p>
  </section>
  <section
    class="max-w-5xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-2 gap-10"
  >
    <!-- Formulario -->
    <div>
      <h2 class="text-xl font-semibold text-neutral-900 mb-4">
        Envíanos un mensaje
      </h2>

      <!--
        Formulario con Netlify Forms:
        - data-netlify="true" activa la detección automática al desplegar en Netlify
        - El input oculto "form-name" es obligatorio para que Netlify lo reconozca
        - El campo "bot-field" es un honeypot anti-spam (debe quedar vacío y oculto)
      -->
      <form
        name="contacto"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-4"
      >
        <input type="hidden" name="form-name" value="contacto" />
        <p class="hidden">
          <label>
            No llenar: <input name="bot-field" />
          </label>
        </p>

        <div>
          <label class="block text-sm font-medium text-neutral-700 mb-1"
            >Nombre</label
          >
          <input
            type="text"
            name="nombre"
            required
            class="w-full border border-neutral-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-neutral-700 mb-1"
            >Teléfono</label
          >
          <input
            type="tel"
            name="telefono"
            required
            class="w-full border border-neutral-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-neutral-700 mb-1"
            >Correo</label
          >
          <input
            type="email"
            name="correo"
            class="w-full border border-neutral-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-neutral-700 mb-1"
            >¿Qué producto te interesa?</label
          >
          <select
            name="producto"
            class="w-full border border-neutral-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="Vidrios">Vidrios</option>
            <option value="Aluminio">Aluminio</option>
            <option value="Accesorios">Accesorios</option>
            <option value="Varios">Varios / No estoy seguro</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-neutral-700 mb-1"
            >Mensaje</label
          >
          <textarea
            name="mensaje"
            rows="4"
            required
            class="w-full border border-neutral-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 transition-colors text-white font-semibold py-3 rounded-lg"
        >
          Enviar mensaje
        </button>
      </form>
    </div>

    <!-- Info + mapa -->
    <div class="space-y-6">
      <div>
        <h2 class="text-xl font-semibold text-neutral-900 mb-3">
          Otras formas de contacto
        </h2>
        <ul class="space-y-2 text-neutral-700">
          <li>
            📞 <a href="tel:+593000000000" class="hover:underline"
              >+593 00 000 0000</a>
          </li>
          <li>
            ✉️ <a href="mailto:correo@andinaglass.com" class="hover:underline"
              >correo@andinaglass.com</a>
          </li>
          <li>📍 Latacunga, Ecuador</li>
          <li>
            💬
            <a
              href="https://wa.me/593000000000"
              target="_blank"
              class="hover:underline text-green-600 font-medium"
            >
              Escríbenos por WhatsApp
            </a>
          </li>
        </ul>
      </div>

      <div
        class="rounded-xl overflow-hidden border border-neutral-200 shadow-sm"
      >
        <iframe
          src="https://www.google.com/maps?q=Latacunga,Ecuador&output=embed"
          width="100%"
          height="300"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</Layout>
