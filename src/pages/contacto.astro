---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contacto | Andina Glass Latacunga"
  description="Contacta con Andina Glass para consultar precios, disponibilidad y cotizaciones de vidrio, aluminio y accesorios en Latacunga."
>
  <!-- Encabezado -->
  <section class="bg-neutral-50 border-b border-neutral-200">
    <div class="max-w-5xl mx-auto px-4 py-10 sm:py-12">
      <!-- Breadcrumb -->
      <div class="text-sm text-neutral-500 mb-6">
        <a href="/" class="hover:text-blue-600 transition-colors"> Inicio </a>

        <span class="mx-2 text-neutral-400">/</span>

        <span class="text-neutral-700"> Contacto </span>
      </div>

      <div class="max-w-2xl">
        <p
          class="text-sm font-semibold uppercase tracking-wider text-blue-600 mb-2"
        >
          Estamos para ayudarte
        </p>

        <h1
          class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-900"
        >
          Contacto
        </h1>

        <p class="mt-3 text-base sm:text-lg leading-7 text-neutral-600">
          Escríbenos para consultar disponibilidad, solicitar una cotización o
          resolver cualquier duda sobre nuestros productos.
        </p>
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section
    class="max-w-5xl mx-auto px-4 py-12 sm:py-14 grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-14"
  >
    <!-- Formulario -->
    <div>
      <div class="mb-6">
        <h2 class="text-2xl font-semibold text-neutral-900">
          Envíanos un mensaje
        </h2>

        <p class="text-sm text-neutral-500 mt-1">
          Completa el formulario y nos pondremos en contacto contigo.
        </p>
      </div>

      <form
        id="contacto-form"
        name="contacto"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-5"
      >
        <input type="hidden" name="form-name" value="contacto" />

        <!-- Honeypot anti-spam -->
        <p class="hidden">
          <label>
            No llenar:
            <input name="bot-field" />
          </label>
        </p>

        <!-- Nombre -->
        <div>
          <label
            for="nombre"
            class="block text-sm font-medium text-neutral-700 mb-1.5"
          >
            Nombre *
          </label>

          <input
            id="nombre"
            type="text"
            name="nombre"
            autocomplete="name"
            required
            minlength="2"
            maxlength="60"
            pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü ]+"
            title="Introduce un nombre válido usando solo letras y espacios."
            placeholder="Tu nombre"
            class="w-full border border-neutral-300 rounded-lg px-4 py-3 text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
          />
        </div>

        <!-- Teléfono -->
        <div>
          <label
            for="telefono"
            class="block text-sm font-medium text-neutral-700 mb-1.5"
          >
            Teléfono *
          </label>

          <input
            id="telefono"
            type="tel"
            name="telefono"
            autocomplete="tel"
            required
            inputmode="numeric"
            pattern="[0-9]{9,15}"
            minlength="9"
            maxlength="15"
            placeholder="Ej. 099 123 4567"
            title="Introduce solo números, entre 9 y 15 dígitos."
            class="w-full border border-neutral-300 rounded-lg px-4 py-3 text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
          />
        </div>

        <!-- Correo -->
        <div>
          <label
            for="correo"
            class="block text-sm font-medium text-neutral-700 mb-1.5"
          >
            Correo electrónico *
          </label>

          <input
            id="correo"
            type="email"
            name="correo"
            autocomplete="email"
            required
            placeholder="correo@ejemplo.com"
            class="w-full border border-neutral-300 rounded-lg px-4 py-3 text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
          />
        </div>

        <!-- Producto -->
        <div>
          <label
            for="producto"
            class="block text-sm font-medium text-neutral-700 mb-1.5"
          >
            ¿Qué producto te interesa?
          </label>

          <select
            id="producto"
            name="producto"
            required
            class="w-full border border-neutral-300 rounded-lg px-4 py-3 bg-white text-neutral-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
          >
            <option value="" selected disabled> Selecciona una opción </option>

            <option value="Vidrios">Vidrios</option>
            <option value="Aluminio">Aluminio</option>
            <option value="Accesorios">Accesorios</option>
            <option value="Varios">Varios / No estoy seguro</option>
          </select>
        </div>

        <!-- Mensaje -->
        <div>
          <label
            for="mensaje"
            class="block text-sm font-medium text-neutral-700 mb-1.5"
          >
            Mensaje *
          </label>

          <textarea
            id="mensaje"
            name="mensaje"
            rows="5"
            required
            minlength="10"
            maxlength="1000"
            placeholder="Cuéntanos qué producto, medida o cantidad necesitas..."
            class="w-full border border-neutral-300 rounded-lg px-4 py-3 text-neutral-900 placeholder:text-neutral-400 resize-y focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
          ></textarea>
        </div>

        <!-- Privacidad -->
        <div class="flex items-start gap-3">
          <input
            id="privacidad"
            type="checkbox"
            name="privacidad"
            required
            class="mt-1 h-4 w-4 rounded border-neutral-300 text-blue-600 focus:ring-blue-500"
          />

          <label for="privacidad" class="text-xs leading-5 text-neutral-500">
            He leído y acepto la <a
              href="/politica"
              class="text-blue-600 hover:underline">Política de privacidad</a
            >.
          </label>
        </div>

        <!-- Enviar -->
        <button
          type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 active:bg-blue-800 transition-colors text-white font-semibold py-3 rounded-lg"
        >
          Enviar mensaje
        </button>
        <p
          id="mensaje-estado"
          class="hidden text-sm text-center font-medium"
          aria-live="polite"
        >
        </p>
      </form>
    </div>

    <!-- Información -->
    <div>
      <div class="mb-6">
        <h2 class="text-2xl font-semibold text-neutral-900">
          Visítanos o contáctanos
        </h2>

        <p class="text-sm text-neutral-500 mt-1">
          También puedes comunicarte directamente con nosotros.
        </p>
      </div>

      <!-- Datos de contacto -->
      <div class="space-y-4">
        <!-- WhatsApp -->
        <a
          href="https://wa.me/593997564672"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-start gap-4 rounded-xl border border-neutral-200 bg-white p-4 hover:border-green-300 hover:shadow-sm transition-all"
        >
          <div
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-green-50 text-xl"
          >
            💬
          </div>

          <div>
            <p
              class="font-semibold text-neutral-900 group-hover:text-green-600 transition-colors"
            >
              WhatsApp
            </p>

            <p class="text-sm text-neutral-500 mt-0.5">+593 99 756 4672</p>

            <p class="text-xs font-medium text-green-600 mt-1">Escríbenos →</p>
          </div>
        </a>

        <!-- Correo -->
        <a
          href="mailto:andinaglassdistribuidora@gmail.com"
          class="group flex items-start gap-4 rounded-xl border border-neutral-200 bg-white p-4 hover:border-blue-300 hover:shadow-sm transition-all"
        >
          <div
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-xl"
          >
            ✉️
          </div>

          <div class="min-w-0">
            <p
              class="font-semibold text-neutral-900 group-hover:text-blue-600 transition-colors"
            >
              Correo electrónico
            </p>

            <p class="text-sm text-neutral-500 mt-0.5 break-all">
              andinaglassdistribuidora@gmail.com
            </p>
          </div>
        </a>

        <!-- Dirección -->
        <a
          href="https://www.google.com/maps?q=-0.9264678,-78.6233681"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-start gap-4 rounded-xl border border-neutral-200 bg-white p-4 hover:border-blue-300 hover:shadow-sm transition-all"
        >
          <div
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-xl"
          >
            📍
          </div>

          <div>
            <p
              class="font-semibold text-neutral-900 group-hover:text-blue-600 transition-colors"
            >
              Dirección
            </p>

            <p class="text-sm text-neutral-500 mt-0.5">
              Melchor de Benavides y Benjamín Terán
            </p>

            <p class="text-sm text-neutral-500">Latacunga, Ecuador</p>

            <p class="text-xs font-medium text-blue-600 mt-1">Cómo llegar →</p>
          </div>
        </a>
      </div>

      <!-- Mapa -->
      <div
        class="mt-6 rounded-xl overflow-hidden border border-neutral-200 shadow-sm"
      >
        <iframe
          src="https://www.google.com/maps?q=-0.9264678,-78.6233681&z=17&output=embed"
          width="100%"
          height="320"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación de Andina Glass en Latacunga"></iframe>
      </div>
    </div>
  </section>
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>("#contacto-form");
  const estado =
    document.querySelector<HTMLParagraphElement>("#mensaje-estado");
  const boton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (!estado || !boton) return;

    boton.disabled = true;
    boton.textContent = "Enviando...";
    estado.classList.add("hidden");

    const formData = new FormData(form);

    try {
      const response = await fetch("/", {
        method: "POST",
        headers: {
          "Content-Type": "application/x-www-form-urlencoded",
        },
        body: new URLSearchParams(
          Array.from(formData.entries()).map(([key, value]) => [
            key,
            String(value),
          ]),
        ).toString(),
      });

      if (!response.ok) {
        throw new Error("Error al enviar el formulario");
      }

      form.reset();

      estado.textContent =
        "✓ Mensaje enviado correctamente. Nos pondremos en contacto contigo lo antes posible.";

      estado.className = "text-sm text-center font-medium text-green-600";
    } catch (error) {
      console.error(error);

      estado.textContent =
        "No se pudo enviar el mensaje. Inténtalo de nuevo o contáctanos por WhatsApp.";

      estado.className = "text-sm text-center font-medium text-red-600";
    } finally {
      boton.disabled = false;
      boton.textContent = "Enviar mensaje";
    }
  });
</script>
