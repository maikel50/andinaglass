---
import Layout from "../layouts/Layout.astro";

const acabados = ["Negro", "Blanco", "Natural", "Maderado"];

const sistemas = [
  {
    nombre: "Ventana de 4-5 perfiles (corrediza)",
    imagen: "/aluminio_corrediza.webp",
    piezas: [
      "Base",
      "Cabezal",
      "Jambas",
      "Peinazo",
      "Parante económico",
      "Parante reforzado",
    ],
  },
  {
    nombre: "Ventana Fija",
    imagen: "/aluminio_fija.webp",
    piezas: [
      "Fija con vena",
      "Fija sin vena",
      "Bordo de la fija",
      "Millón",
    ],
  },
  {
    nombre: "Ventana Proyectable",
    imagen: "/ventana_proyectable.webp",
    piezas: [
      "Hoja",
      "Marco",
      "T proyectable",
      "Bordo redondo",
      "Ancla proyectable",
    ],
  },
  {
    nombre: "Puerta Batiente",
    imagen: "/puerta_batiente.webp",
    piezas: [
      "Marco abierto",
      "Marco cerrado",
    ],
  },
  {
    nombre: "Tubos estructurales",
    imagen: "/tubos_estructurales.webp",
    piezas: [
      "Tubo 1½ x 1½",
      "Tubo chapero",
      "Tubo 2 x ½",
      "Tubo 1¼ x ¼",
      "Tubo 1 x 1",
    ],
  },
  {
    nombre: "Ángulos",
    imagen: "/angulos.webp",
    piezas: [
      "Ángulo ½ x ½",
      "Ángulo 1 x ½",
      "Ángulo 1 x 1",
    ],
  },
  {
    nombre: "Junquillos",
    imagen: "/junquillos.webp",
    piezas: [
      "Junquillo redondo fijo",
      "Junquillo redondo móvil",
    ],
  },
];
---

<Layout>

  <!-- Encabezado -->
  <section class="bg-neutral-50 border-b border-neutral-200">
    <div class="max-w-6xl mx-auto px-4 py-10 sm:py-12">

      <!-- Breadcrumb -->
      <div class="text-sm text-neutral-500 mb-6">
        <a
          href="/"
          class="hover:text-blue-600 transition-colors"
        >
          Inicio
        </a>

        <span class="mx-2 text-neutral-400">/</span>

        <span class="text-neutral-700">
          Aluminio
        </span>
      </div>

      <div class="max-w-2xl">

        <p class="text-sm font-semibold uppercase tracking-wider text-blue-600 mb-2">
          Catálogo
        </p>

        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-900">
          Aluminio
        </h1>

        <p class="mt-3 text-base sm:text-lg leading-7 text-neutral-600">
          Perfilería de aluminio para ventanas, puertas y estructuras,
          disponible en diferentes sistemas y acabados.
        </p>

      </div>

      <!-- Acabados -->
      <div class="mt-7">

        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-3">
          Acabados disponibles
        </p>

        <div class="flex flex-wrap gap-2">

          {
            acabados.map((acabado) => (
              <span
                class="inline-flex items-center rounded-full border border-neutral-300 bg-white px-4 py-2 text-sm font-medium text-neutral-700"
              >
                {acabado}
              </span>
            ))
          }

        </div>

      </div>

    </div>
  </section>


  <!-- Sistemas -->
  <section class="max-w-6xl mx-auto px-4 py-12 sm:py-14">

    <div class="flex items-end justify-between gap-4 mb-8">

      <div>
        <h2 class="text-xl sm:text-2xl font-semibold text-neutral-900">
          Sistemas de aluminio
        </h2>

        <p class="mt-1 text-sm text-neutral-500">
          Consulta los perfiles disponibles para cada sistema.
        </p>
      </div>

      <span class="hidden sm:block text-sm text-neutral-500">
        {sistemas.length} sistemas
      </span>

    </div>


    <!-- Tarjetas -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

      {
        sistemas.map((sis) => (
          <article
            class="group overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
          >

            <!-- Imagen -->
            <div class="aspect-[4/3] overflow-hidden bg-neutral-100">

              <img
                src={sis.imagen}
                alt={sis.nombre}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />

            </div>


            <!-- Contenido -->
            <div class="p-5">

              <h3 class="text-lg font-semibold leading-6 text-neutral-900">
                {sis.nombre}
              </h3>


              <!-- Perfiles -->
              <div class="mt-5 border-t border-neutral-100 pt-4">

                <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-3">
                  Perfiles disponibles
                </p>

                <ul class="space-y-2">

                  {
                    sis.piezas.map((pieza) => (
                      <li class="flex items-start gap-2 text-sm text-neutral-600">

                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span>

                        <span class="leading-5">
                          {pieza}
                        </span>

                      </li>
                    ))
                  }

                </ul>

              </div>


              <!-- CTA -->
              <a
                href="https://wa.me/593997564672"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center w-full mt-5 rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-600 transition-colors"
              >
                Consultar disponibilidad
                <span class="ml-2">→</span>
              </a>

            </div>

          </article>
        ))
      }

    </div>

  </section>


  <!-- CTA final -->
  <section class="border-t border-neutral-200 bg-neutral-50">

    <div class="max-w-6xl mx-auto px-4 py-12 text-center">

      <h2 class="text-2xl font-semibold text-neutral-900">
        ¿Necesitas perfilería de aluminio?
      </h2>

      <p class="mt-2 text-neutral-600 max-w-xl mx-auto">
        Contáctanos para consultar disponibilidad, acabados y perfiles.
      </p>
      <div class="mt-8 flex justify-center">
        <p class="text-xs text-neutral-500 text-center max-w-2xl">
          Imágenes referenciales. Los productos pueden variar según modelo,
          acabado y disponibilidad.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row justify-center gap-3 mt-6">

        <a
          href="https://wa.me/593997564672"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-white hover:bg-blue-700 transition-colors"
        >
          Consultar por WhatsApp
        </a>

        <a
          href="/contacto"
          class="inline-flex items-center justify-center rounded-lg border border-neutral-300 bg-white px-6 py-3 text-sm font-semibold text-neutral-700 hover:bg-neutral-100 transition-colors"
        >
          Ir a contacto
        </a>

      </div>

    </div>

  </section>

</Layout>