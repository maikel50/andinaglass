---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Mensaje enviado | Andina Glass"
  description="Tu mensaje ha sido enviado correctamente a Andina Glass."
>
  <section class="min-h-[60vh] flex items-center justify-center px-4 py-16">
    <div
      class="max-w-lg w-full text-center bg-white border border-neutral-200 rounded-2xl shadow-sm p-8"
    >
      <div class="text-5xl mb-4">✓</div>

      <h1 class="text-3xl font-bold text-neutral-900 mb-3">
        ¡Mensaje enviado!
      </h1>

      <p class="text-neutral-600 mb-8">
        Hemos recibido tu consulta correctamente. Nos pondremos en contacto
        contigo lo antes posible.
      </p>

      <a
        href="/"
        class="inline-flex items-center justify-center bg-blue-600 text-white font-semibold px-6 py-3 rounded-xl hover:bg-blue-700 transition"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>
