---
import Layout from "../layouts/Layout.astro";

const categorias = [
  {
    nombre: "Silicones y selladores",
    imagen: "/img_siliconas.webp",
    productos: [
      "Silicón Abro",
      "Silicón inox E1200",
      "Silicón inox G1200",
    ],
  },
  {
    nombre: "Chapas y cerraduras",
    imagen: "/img_chapas_cerraduras.webp",
    productos: [
      "Chapa pomo para baño",
      "Chapa de pomo para dormitorio",
      "Chapa pico de loro",
      "Seguros de botón",
      "Seguros europeos",
      "Seguros de manija",
      "Seguros de caracol",
    ],
  },
  {
    nombre: "Accesorios para vidrio templado",
    imagen: "/img_accesorios_vidrio_templado.webp",
    productos: [
      "Pibot",
      "Puntos fijos para vidrio templado",
      "Bisagras para vidrio templado",
      "Chapetas",
      "Jaladeras tubulares",
    ],
  },
  {
    nombre: "Tornillería y fijación",
    imagen: "/img_tornilleria_fijacion.webp",
    productos: [
      "Tornillos 7×2",
      "Tornillos 8×1/2",
      "Tornillos 8×2",
      "Tornillos 8×2 1/2",
      "Remaches",
      "Anclas dado",
    ],
    detalle: "Tornillos disponibles en negro y galvanizado",
  },
  {
    nombre: "Accesorios para ventanas",
    imagen: "/img_accesorios_ventana.webp",
    productos: [
      'Brazos de proyectable de 8"',
      'Brazos de proyectable de 10"',
      'Brazos de proyectable de 12"',
      "Bisagras Omega",
      "Brazos cierra puerta Felfa para ventanas",
      "Ruedas simples",
      "Ruedas dobles",
    ],
  },
  {
    nombre: "Viniles y complementos",
    imagen: "/img_viniles_complementos.webp",
    productos: [
      "Vinil en varias numeraciones",
    ],
  },
  {
    nombre: "Herramientas",
    imagen: "/img_herramientas.webp",
    productos: [
      "Brocas",
      "Pistolas de silicón",
    ],
  },
  {
    nombre: "Accesorios para baño",
    imagen: "/img_accesorios_baño.webp",
    productos: [
      "Toalleros",
    ],
  },
  {
    nombre: "Instalación y protección",
    imagen: "/img_instalacion_proteccion.webp",
    productos: [
      "Cintas doble faz para piel de vidrio",
      "Maskin",
      "Guantes para manipular vidrio",
    ],
  },
];
---

<Layout
  title="Accesorios para vidrio y aluminio | Andina Glass"
  description="Accesorios, herrajes, silicones, tornillería y herramientas para vidrio y aluminio en Latacunga."
>

  <!-- Encabezado -->
  <section class="bg-neutral-50 border-b border-neutral-200">
    <div class="max-w-6xl mx-auto px-4 py-10 sm:py-12">

      <!-- Breadcrumb -->
      <div class="text-sm text-neutral-500 mb-6">
        <a
          href="/"
          class="hover:text-blue-600 transition-colors"
        >
          Inicio
        </a>

        <span class="mx-2 text-neutral-400">/</span>

        <span class="text-neutral-700">
          Accesorios
        </span>
      </div>

      <div class="max-w-2xl">

        <p class="text-sm font-semibold uppercase tracking-wider text-blue-600 mb-2">
          Catálogo
        </p>

        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-900">
          Accesorios
        </h1>

        <p class="mt-3 text-base sm:text-lg leading-7 text-neutral-600">
          Herrajes, herramientas y complementos para instalación,
          fabricación y mantenimiento de trabajos en vidrio y aluminio.
        </p>

      </div>

    </div>
  </section>


  <!-- Categorías -->
  <section class="max-w-6xl mx-auto px-4 py-12 sm:py-14">

    <div class="flex items-end justify-between gap-4 mb-8">

      <div>
        <h2 class="text-xl sm:text-2xl font-semibold text-neutral-900">
          Categorías de accesorios
        </h2>

        <p class="mt-1 text-sm text-neutral-500">
          Encuentra herrajes, fijaciones, herramientas y complementos.
        </p>
      </div>

      <span class="hidden sm:block text-sm text-neutral-500">
        {categorias.length} categorías
      </span>

    </div>


    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

      {
        categorias.map((cat) => (
          <article
            class="group flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
          >

            <!-- Imagen -->
            <div class="aspect-[4/3] overflow-hidden bg-neutral-100">

              <img
                src={cat.imagen}
                alt={cat.nombre}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />

            </div>


            <!-- Contenido -->
            <div class="flex flex-col flex-1 p-5">

              <h3 class="text-lg font-semibold leading-6 text-neutral-900">
                {cat.nombre}
              </h3>


              <!-- Productos -->
              <div class="mt-4 border-t border-neutral-100 pt-4">

                <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-3">
                  Productos
                </p>

                <ul class="space-y-2">

                  {
                    cat.productos.map((producto) => (
                      <li class="flex items-start gap-2 text-sm text-neutral-600">

                        <span
                          class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"
                        >
                        </span>

                        <span class="leading-5">
                          {producto}
                        </span>

                      </li>
                    ))
                  }

                </ul>

              </div>


              <!-- Información adicional -->
              {
                cat.detalle && (
                  <div class="mt-4 rounded-lg bg-blue-50 px-3 py-2.5">
                    <p class="text-xs leading-5 text-blue-700">
                      {cat.detalle}
                    </p>
                  </div>
                )
              }


              <!-- CTA -->
              <div class="mt-auto pt-5">

                <a
                  href="https://wa.me/593997564672"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center w-full rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-600 transition-colors"
                >
                  Consultar disponibilidad
                  <span class="ml-2">→</span>
                </a>

              </div>

            </div>

          </article>
        ))
      }

    </div>

  </section>


  <!-- CTA final -->
  <section class="border-t border-neutral-200 bg-neutral-50">

    <div class="max-w-6xl mx-auto px-4 py-12 text-center">

      <h2 class="text-2xl font-semibold text-neutral-900">
        ¿Buscas algún accesorio específico?
      </h2>

      <p class="mt-2 text-neutral-600 max-w-xl mx-auto">
        Escríbenos y consulta disponibilidad de herrajes, herramientas,
        fijaciones y complementos.
      </p>
      <div class="mt-8 flex justify-center">
        <p class="text-xs text-neutral-500 text-center max-w-2xl">
          Imágenes referenciales. Los productos pueden variar según modelo,
          acabado y disponibilidad.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row justify-center gap-3 mt-6">

        <a
          href="https://wa.me/593997564672"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-white hover:bg-blue-700 transition-colors"
        >
          Consultar por WhatsApp
        </a>

        <a
          href="/contacto"
          class="inline-flex items-center justify-center rounded-lg border border-neutral-300 bg-white px-6 py-3 text-sm font-semibold text-neutral-700 hover:bg-neutral-100 transition-colors"
        >
          Ir a contacto
        </a>

      </div>

    </div>

  </section>

</Layout>