---
import Layout from "../layouts/Layout.astro";

const categorias = [
  {
    nombre: "Flotado Claro",
    imagen: "/FlotadoClaro.webp",
    descripcion: "Vidrio transparente para diferentes aplicaciones.",
    variantes: [
      "Claro 3mm — 244x183",
      "Claro 4mm — 214x330",
      "Claro 6mm — 214x330",
    ],
  },
  {
    nombre: "Flotado Color",
    imagen: "/FlotadoColor.webp",
    descripcion: "Vidrios tintados disponibles en diferentes tonalidades.",
    variantes: [
      "Dark Grey 4mm — 214x330 / 214x366",
      "Dark Grey 6mm — 214x330 / 214x366",
      "Bronce Normal 4mm / 6mm — 214x330",
      "Verde Automotriz 6mm — 214x330",
      "Gris 4mm / 6mm — 214x330",
      "Negro Indonés 6mm — 214x330",
    ],
  },
  {
    nombre: "Reflectivo",
    imagen: "/Reflectivo.webp",
    descripcion: "Vidrios con acabado reflectivo para proyectos arquitectónicos.",
    variantes: [
      "Blue Reflectivo 4mm / 6mm — 214x330",
      "Bronce Reflectivo 4mm / 6mm — 214x330",
      "Verde Botella Reflectivo 4mm / 6mm — 214x330",
    ],
  },
  {
    nombre: "Esmerilado (Alaciado)",
    imagen: "/Esmerilado.webp",
    descripcion: "Acabado translúcido para mayor privacidad y diseño.",
    variantes: [
      "Alaciado 4mm — 214x330",
      "Alaciado 6mm — 214x330",
    ],
  },
  {
    nombre: "Catedral",
    imagen: "/catedral.webp",
    descripcion: "Vidrios decorativos con diferentes texturas y acabados.",
    variantes: [
      "Putzel Claro 4mm — 244x183",
      "Putzel Bronce 4mm — 244x183",
      "Acanalado 5mm — 214x250",
      "Cebra 4mm — 244x183",
    ],
  },
  {
    nombre: "Espejo",
    imagen: "/Espejo.webp",
    descripcion: "Espejos disponibles en diferentes espesores y medidas.",
    variantes: [
      "Espejo 2mm — 160x220",
      "Espejo 3mm — 244x183",
      "Espejo 6mm — 214x330",
    ],
  },
  {
    nombre: "Laminado",
    imagen: "/laminado.webp",
    descripcion: "Vidrio laminado para proyectos que requieren mayor protección.",
    variantes: [
      "Claro 3+3mm — 214x330",
      "Claro 3+3mm — 214x366",
    ],
  },
];
---

<Layout
  title="Vidrios en Latacunga | Andina Glass"
  description="Consulta nuestra variedad de vidrios en Latacunga: vidrio claro, color, reflectivo, esmerilado, espejo, laminado y más."
>

  <!-- Encabezado -->
  <section class="bg-neutral-50 border-b border-neutral-200">
    <div class="max-w-6xl mx-auto px-4 py-10 sm:py-12">

      <!-- Breadcrumb -->
      <div class="text-sm text-neutral-500 mb-6">
        <a href="/" class="hover:text-blue-600 transition-colors">
          Inicio
        </a>

        <span class="mx-2 text-neutral-400">/</span>

        <span class="text-neutral-700">
          Vidrios
        </span>
      </div>

      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-blue-600 mb-2">
          Catálogo
        </p>

        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-900">
          Vidrios
        </h1>

        <p class="mt-3 text-base sm:text-lg leading-7 text-neutral-600">
          Diferentes tipos de vidrio, acabados, espesores y medidas para
          proyectos de construcción, arquitectura y diseño.
        </p>
      </div>

    </div>
  </section>


  <!-- Catálogo -->
  <section class="max-w-6xl mx-auto px-4 py-12 sm:py-14">

    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-xl sm:text-2xl font-semibold text-neutral-900">
          Tipos de vidrio
        </h2>

        <p class="mt-1 text-sm text-neutral-500">
          Consulta disponibilidad y precios de cada producto.
        </p>
      </div>

      <span class="hidden sm:block text-sm text-neutral-500">
        {categorias.length} categorías
      </span>
    </div>


    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

      {
        categorias.map((cat) => (
          <article
            class="group overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
          >

            <!-- Imagen -->
            <div class="aspect-4/3 overflow-hidden bg-neutral-100">
              <img
                src={cat.imagen}
                alt={cat.nombre}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>


            <!-- Contenido -->
            <div class="p-5">

              <h3 class="text-lg font-semibold text-neutral-900">
                {cat.nombre}
              </h3>

              <p class="mt-1.5 text-sm leading-5 text-neutral-500">
                {cat.descripcion}
              </p>


              <!-- Variantes -->
              <div class="mt-5 border-t border-neutral-100 pt-4">

                <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-3">
                  Disponible
                </p>

                <ul class="space-y-2">

                  {
                    cat.variantes.map((v) => (
                      <li class="flex items-start gap-2 text-sm text-neutral-600">

                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span>

                        <span class="leading-5">
                          {v}
                        </span>

                      </li>
                    ))
                  }

                </ul>

              </div>


              <!-- CTA -->
              <a
                href="https://wa.me/593997564672"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center w-full mt-5 rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-600 transition-colors"
              >
                Consultar disponibilidad
                <span class="ml-2">→</span>
              </a>

            </div>

          </article>
        ))
      }

    </div>

  </section>


  <!-- CTA final -->
  <section class="border-t border-neutral-200 bg-neutral-50">

    <div class="max-w-6xl mx-auto px-4 py-12 text-center">

      <h2 class="text-2xl font-semibold text-neutral-900">
        ¿Necesitas otro tipo de vidrio?
      </h2>

      <p class="mt-2 text-neutral-600 max-w-xl mx-auto">
        Contáctanos para consultar disponibilidad, medidas y precios.
      </p>
      <div class="mt-8 flex justify-center">
        <p class="text-xs text-neutral-500 text-center max-w-2xl">
          Imágenes referenciales. Los productos pueden variar según modelo,
          acabado y disponibilidad.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row justify-center gap-3 mt-6">

        <a
          href="https://wa.me/593997564672"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-white hover:bg-blue-700 transition-colors"
        >
          Consultar por WhatsApp
        </a>

        <a
          href="/contacto"
          class="inline-flex items-center justify-center rounded-lg border border-neutral-300 bg-white px-6 py-3 text-sm font-semibold text-neutral-700 hover:bg-neutral-100 transition-colors"
        >
          Ir a contacto
        </a>

      </div>

    </div>

  </section>

</Layout>