---
const footerLinks = [
  { href: "/vidrios", label: "Vidrios" },
  { href: "/aluminio", label: "Aluminio" },
  { href: "/accesorios", label: "Accesorios" },
  { href: "/catalogo", label: "Catálogo" },
  { href: "/contacto", label: "Contacto" },
];

const legalLinks = [
  { href: "/politica", label: "Política de privacidad" },
  { href: "/terminos", label: "Términos y condiciones" },
];
---

<footer class="bg-neutral-900 text-neutral-300">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
      <!-- Empresa -->
      <div>
        <a
          href="/"
          class="inline-flex items-center bg-white rounded-lg px-3 py-2"
          aria-label="Andina Glass - Inicio"
        >
          <img
            src="/Logo_AndinaGlass.webp"
            alt="Andina Glass"
            class="h-14 w-auto"
          />
        </a>

        <p class="mt-4 text-sm leading-6 text-neutral-400 max-w-sm">
          Distribución de vidrios, aluminio y accesorios para proyectos de
          construcción, decoración y diseño.
        </p>

        <a
          href="https://www.google.com/maps/search/?api=1&query=Melchor+de+Benavides+y+Benjam%C3%ADn+Ter%C3%A1n%2C+Latacunga%2C+Ecuador"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-start gap-2 text-neutral-400 hover:text-blue-500 transition-colors"
        >
          <span class="text-base">📍</span>

          <span>
            <span
              class="block text-neutral-300 font-medium group-hover:text-blue-500"
            >
              Dirección
            </span>
            <span class="block mt-0.5">
              Melchor de Benavides y Benjamín Terán
            </span>
            <span class="block"> Latacunga</span>
          </span>
        </a>
      </div>

      <!-- Navegación -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">
          Catálogo
        </h3>

        <ul class="mt-4 space-y-3 text-sm">
          {
            footerLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:text-blue-500 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">
          Contacto
        </h3>

        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a
              href="https://wa.me/593997564672"
              target="_blank"
              class="hover:underline text-white-600 font-medium"
            >
              +593 99 756 4672
            </a>
          </li>

          <li>
            <a
              href="mailto:andinaglassdistribuidora@gmail.com"
              class="hover:text-blue-500 transition-colors break-all"
            >
              andinaglassdistribuidora@gmail.com
            </a>
          </li>
        </ul>

        <div class="flex gap-4 mt-5 text-sm">
          <a
            href="https://www.tiktok.com/@andina.glass"
            aria-label="TikTok"
            class="hover:text-blue-500 transition-colors"
          >
            TikTok
          </a>

          <a
            href="https://wa.me/593997564672"
            aria-label="WhatsApp"
            class="hover:text-blue-500 transition-colors"
          >
            WhatsApp
          </a>
        </div>
      </div>
    </div>

    <!-- Separador -->
    <div class="border-t border-neutral-800 mt-10 pt-6">
      <div
        class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-neutral-500"
      >
        <p class="text-center sm:text-left">
          © {new Date().getFullYear()} Andina Glass. Todos los derechos reservados.
        </p>

        <!-- Información legal -->
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-2">
          {
            legalLinks.map((link) => (
              <a
                href={link.href}
                class="hover:text-neutral-300 transition-colors"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <p class="text-center mt-4 text-xs text-neutral-600">
        Vidrios · Aluminio · Accesorios
      </p>
    </div>
  </div>
</footer>
