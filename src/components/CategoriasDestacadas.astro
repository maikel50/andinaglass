---
const categorias = [
  {
    nombre: "Vidrios",
    descripcion:
      "Claro, reflectivo, esmerilado, catedral, espejo, laminado y más.",
    href: "/vidrios",
    imagen: "/categoria-vidrios.jpg",
  },
  {
    nombre: "Aluminio",
    descripcion:
      "Perfilería para ventanas corredizas, fijas, proyectables y puertas.",
    href: "/aluminio",
    imagen: "/categoria-aluminio.jpg",
  },
  {
    nombre: "Accesorios",
    descripcion:
      "Herrajes, selladores, chapas, tornillería y sistemas de apertura.",
    href: "/accesorios",
    imagen: "/categoria-accesorios.jpg",
  },
];
---

<section class="max-w-6xl mx-auto px-4 py-16">
  <h2 class="text-2xl md:text-3xl font-bold text-center text-neutral-900 mb-10">
    Nuestro catálogo
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {
      categorias.map((cat) => (
        <a
          href={cat.href}
          class="group block rounded-xl overflow-hidden border border-neutral-200 shadow-sm hover:shadow-lg transition-shadow"
        >
          <div class="h-48 bg-neutral-100 overflow-hidden">
            <img
              src={cat.imagen}
              alt={cat.nombre}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <div class="p-5">
            <h3 class="text-lg font-semibold text-neutral-900 mb-1">
              {cat.nombre}
            </h3>
            <p class="text-sm text-neutral-600">{cat.descripcion}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>
