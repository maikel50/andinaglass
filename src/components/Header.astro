---
const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/vidrios", label: "Vidrios" },
  { href: "/aluminio", label: "Aluminio" },
  { href: "/accesorios", label: "Accesorios" },
  { href: "/contacto", label: "Contacto" },
];
---

<header class="w-full">
  <!-- Barra superior -->
  <div class="bg-neutral-900 text-neutral-300 text-xs sm:text-sm">
    <div
      class="max-w-6xl mx-auto px-4 py-2 flex flex-wrap justify-between items-center gap-x-6 gap-y-1"
    >
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <a
          href="https://wa.me/593997564672"
          target="_blank"
          class="hover:underline text-white-600 font-medium"
        >
          +593 99 756 4672
        </a>

        <a
          href="mailto:andinaglassdistribuidora@gmail.com"
          class="hidden sm:block hover:text-white transition-colors"
        >
          andinaglassdistribuidora@gmail.com
        </a>
      </div>

      <a
        href="https://www.google.com/maps?q=-0.9264678,-78.6233681"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="text-base">📍</span>
        Melchor de Benavides y Benjamín Terán, Latacunga
      </a>
    </div>
  </div>

  <!-- Navegación principal -->
  <div class="bg-white border-b border-neutral-200">
    <div class="max-w-6xl mx-auto px-4 h-20 flex items-center justify-between">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center shrink-0"
        aria-label="Andina Glass - Inicio"
      >
        <img
          src="/Logo_AndinaGlass.webp"
          alt="Andina Glass"
          class="h-21 w-auto"
        />
      </a>

      <!-- Menú escritorio -->
      <nav class="hidden md:flex items-center gap-8">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-neutral-700 hover:text-blue-600 transition-colors"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Botón móvil -->
      <button
        id="menu-toggle"
        type="button"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg text-neutral-700 hover:bg-neutral-100 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <span class="text-2xl leading-none">☰</span>
      </button>
    </div>

    <!-- Menú móvil -->
    <nav
      id="mobile-menu"
      class="hidden md:hidden border-t border-neutral-200 bg-white"
    >
      <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="py-3 text-neutral-700 font-medium border-b border-neutral-100 last:border-0 hover:text-blue-600 transition-colors"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");

    const expanded = toggle.getAttribute("aria-expanded") === "true";

    toggle.setAttribute("aria-expanded", String(!expanded));
  });
</script>
